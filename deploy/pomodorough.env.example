LISTEN_ADDR=127.0.0.1:8790
# Must reach this instance directly; fail-closed dependency checks gate systemd startup.
READINESS_URL=http://127.0.0.1:8790/readyz
DATA_DIR=/var/lib/pomodorough
# Keep outside DATA_DIR and never roll it back during account-data restoration.
DELETION_LEDGER_DIR=/var/lib/pomodorough-deletion-ledger
WEB_ROOT=/etc/pomodorough/web
PUBLIC_URL=https://pomodorough.egigoka.me

# Disabled by default: rate limits use the direct peer address. Configure both
# only when every request reaches the service through an exact trusted path.
# TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
# TRUSTED_PROXY_HOPS=1

# Generate once with: openssl rand -hex 32
# Keep this value stable; it determines user IDs and protects transient tokens.
APP_SECRET=replace-with-at-least-32-random-bytes

# Google OAuth web client. Redirect URI:
# https://pomodorough.egigoka.me/auth/google/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# Comma-separated iOS, Android, and desktop OAuth client IDs.
GOOGLE_NATIVE_CLIENT_IDS=
