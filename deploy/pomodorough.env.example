LISTEN_ADDR=127.0.0.1:8790
DATA_DIR=/var/lib/pomodorough
WEB_ROOT=/etc/pomodorough/web
PUBLIC_URL=https://pomodorough.egigoka.me

# Generate once with: openssl rand -hex 32
# Keep this value stable; it determines user IDs and protects transient tokens.
APP_SECRET=replace-with-at-least-32-random-bytes

# Google OAuth web client. Redirect URI:
# https://pomodorough.egigoka.me/auth/google/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# Comma-separated iOS, Android, and desktop OAuth client IDs.
GOOGLE_NATIVE_CLIENT_IDS=
